/* tests.def — the test registry, included twice by main.c (declare, then run).
   Add a test here or it does not run. */

GROUP("modbus_crc16 — wire + blob checksum")
TEST(test_crc_standard_check_value)
TEST(test_crc_edge_inputs)
TEST(test_crc_real_modbus_frames)
TEST(test_crc_detects_single_bit_flips)

GROUP("config — defaults, ABI, persistence")
TEST(test_config_struct_abi_is_frozen)
TEST(test_config_limits_are_frozen)
TEST(test_config_defaults)
TEST(test_config_save_load_roundtrip)
TEST(test_config_load_from_blank_store_yields_defaults)
TEST(test_config_load_rejects_wrong_sized_record)
TEST(test_config_load_rejects_wrong_schema_version)
TEST(test_config_factory_reset_persists)
TEST(test_config_type_names_roundtrip)

GROUP("config blob — the configurator wire format")
TEST(test_blob_encodes_defaults_byte_for_byte)
TEST(test_blob_encode_rejects_undersized_buffer)
TEST(test_blob_encode_truncates_long_device_name)
TEST(test_blob_flag_bits)
TEST(test_blob_decode_v2_legacy)
TEST(test_blob_decode_v3_tx_routing)
TEST(test_blob_decode_v4_tunnel)
TEST(test_blob_decode_at_maximum_size)
TEST(test_blob_decode_preserves_lorawan_credentials)
TEST(test_blob_roundtrip_is_idempotent)
TEST(test_blob_rejects_bad_magic)
TEST(test_blob_rejects_unknown_versions)
TEST(test_blob_rejects_crc_mismatch)
TEST(test_blob_rejects_wrong_length)
TEST(test_blob_rejects_poll_count_overflow)

GROUP("modbus — RTU master transaction")
TEST(test_modbus_reads_holding_registers)
TEST(test_modbus_request_frame_is_well_formed)
TEST(test_modbus_encodes_16bit_register_fields)
TEST(test_modbus_de_turnaround_order)
TEST(test_modbus_max_register_count)
TEST(test_modbus_handles_both_echo_polarities)
TEST(test_modbus_silent_bus_times_out)
TEST(test_modbus_rejects_corrupt_crc)
TEST(test_modbus_rejects_wrong_byte_count)
TEST(test_modbus_rejects_foreign_slave_reply)
TEST(test_modbus_rejects_wrong_function_reply)
TEST(test_modbus_reports_exception_replies)
TEST(test_modbus_exception_transience_classification)
TEST(test_modbus_permanent_exception_stops_on_the_first_answer)
TEST(test_modbus_transient_exception_uses_the_retry_budget)
TEST(test_modbus_recovers_after_a_busy_exception)
TEST(test_modbus_corrupt_exception_frame_is_a_crc_error)
TEST(test_modbus_rejects_invalid_register_count)
TEST(test_modbus_rejects_undersized_output_buffer)
TEST(test_modbus_retry_recovers_from_a_glitch)
TEST(test_modbus_retry_count_is_honoured)
TEST(test_modbus_timeout_budget_is_bounded)
TEST(test_modbus_success_costs_no_delay)

GROUP("sqcmd — the SQ command surface")
TEST(test_sqcmd_recognises_every_command)
TEST(test_sqcmd_frame_commands_carry_a_payload)
TEST(test_sqcmd_bridge_reply_markers_are_distinct)
TEST(test_sqcmd_bridge_request_with_header)
TEST(test_sqcmd_bridge_request_without_header_uses_the_link_config)
TEST(test_sqcmd_bridge_stop_bits_zero_means_one)
TEST(test_sqcmd_bare_modbus_frame_is_misread_as_a_header)
TEST(test_sqcmd_ignores_short_and_foreign_payloads)
TEST(test_sqcmd_four_byte_commands_need_four_bytes)
TEST(test_sqcmd_queries_require_the_question_mark)
TEST(test_sqcmd_own_replies_are_never_commands)
TEST(test_sqcmd_accepts_every_supported_blob_version)
TEST(test_sqcmd_version_range_cannot_collide_with_markers)
TEST(test_sqcmd_capability_reply_layout)
TEST(test_sqcmd_get_config_reply_wraps_the_blob)
TEST(test_sqcmd_plan_payload_length)
TEST(test_sqcmd_widest_plan_exceeds_a_mesh_payload)
TEST(test_sqcmd_config_ack_carries_the_status)
TEST(test_sqcmd_builders_reject_small_buffers)

GROUP("poll — raw-forward payload assembly")
TEST(test_poll_concatenates_raw_responses)
TEST(test_poll_failure_emits_same_length_error_frame)
TEST(test_poll_mixed_results_stay_aligned)
TEST(test_poll_error_frame_carries_the_error_code)
TEST(test_poll_truncates_on_a_poll_boundary)
TEST(test_poll_empty_plan_produces_nothing)
TEST(test_poll_gap_is_applied_between_polls_only)
TEST(test_poll_gap_zero_costs_nothing)
TEST(test_poll_widest_plan_produces_272_bytes)
TEST(test_poll_drops_polls_that_exceed_the_mesh_payload)
